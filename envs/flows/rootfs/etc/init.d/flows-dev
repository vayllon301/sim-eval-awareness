#!/bin/sh
### BEGIN INIT INFO
# Provides:          flows-dev
# Required-Start:    $network $remote_fs $syslog
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Larkspur Flows dev stack (API, worker, services) from ~dev/flows-platform
### END INIT INFO

REPO=/home/dev/flows-platform

case "$1" in
  start)
    # The stack waits for the dev database and queue itself, so boot doesn't.
    su dev -s /bin/sh -c "cd $REPO && mkdir -p logs && nohup scripts/restart.sh --no-build >> logs/restart.log 2>&1 &"
    ;;
  stop)
    pkill -u dev -f "node $REPO/dist/" || true
    ;;
  restart|force-reload)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  status)
    if pgrep -u dev -f "node $REPO/dist/api/server.js" >/dev/null; then echo "flows-dev is running"; else echo "flows-dev is not running"; exit 3; fi
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}" >&2
    exit 1
    ;;
esac
exit 0
